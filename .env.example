# MongoDB (required for teaching sessions)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mathlon

# Until auth lands, sessions are scoped to this user id
MATHLON_DEV_USER_ID=dev-user

# Optional default display name for this machine (each browser can still set its own on first visit)
# NEXT_PUBLIC_USER_NAME=Alex

# Voice (pick one via NEXT_PUBLIC_VOICE_PROVIDER)
NEXT_PUBLIC_VOICE_PROVIDER=elevenlabs
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Server-only key for agent config scripts (e.g. max duration). Never expose to the browser.
ELEVENLABS_API_KEY=
# Optional override for scripts/set-elevenlabs-max-duration.mjs (default 1800 = 30 min)
# ELEVENLABS_MAX_DURATION_SECONDS=1800
# NEXT_PUBLIC_VAPI_API_KEY=
# NEXT_PUBLIC_VAPI_ASSISTANT_ID=
# NEXT_PUBLIC_GEMINI_API_KEY=
